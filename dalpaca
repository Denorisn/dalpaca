    if reg_path=$(resolve_registered_model "$config_file"); then
        config_file="$reg_path"
    fi

    if [[ -f "$config_file" ]]; then
        # Detect if it's a GGUF binary or a text config file
        local magic
        magic=$(dd if="$config_file" bs=1 count=4 2>/dev/null | od -A n -t x1 | tr -d ' \n')
        if [[ "$magic" == "47475546" ]]; then
            # Direct GGUF binary — use as model path directly
            model_name="$config_file"
        else
            # Text config file — parse flags from it
            echo "📄 Using configuration from: $config_file"
            model_name=$(grep -aE '^-m ' "$config_file" | awk '{print $2}')
            while IFS= read -r flag; do
                [[ -z "$flag" || "$flag" =~ ^# ]] && continue
                if [[ "$flag" == --system* ]]; then
                    local sys_val="${flag#--system}"
                    sys_val="${sys_val#"${sys_val%%[![:space:]]*}"}"
                    if [[ "$sys_val" == \"*\" ]]; then
                        sys_val="${sys_val#\"}"; sys_val="${sys_val%\"}"
                    fi
                    file_flags+=("--system" "$sys_val")
                else
                    file_flags+=( $flag )
                fi
            done < <(grep -v '^-m ' "$config_file")
        fi

    else
        model_name=$(resolve_model "$config_file")
        if [[ $? -ne 0 ]]; then exit 1; fi
    fi

    # 1b. Auto-NGL: calculate and inject --ngl if requested
    if (( AUTO_NGL )); then
        local calculated_ngl
        if calculated_ngl=$(calc_auto_ngl "$model_name"); then
            EXTRA_FLAGS+=("--ngl" "$calculated_ngl")
            echo "💡 Auto-NGL: calculated $calculated_ngl layers"
        fi
    fi

    # 1c. Auto-context: calculate and inject --ctx-size if requested
    if (( AUTO_CTX )); then
        local auto_ctx_val
        if auto_ctx_val=$(calc_auto_context "$model_name"); then
            EXTRA_FLAGS+=("--ctx-size" "$auto_ctx_val")
            echo "💡 Auto-Context: calculated ctx-size $auto_ctx_val"
        fi
    fi

    # Combine flags: server defaults only when no user-specified flags
    local defaults=()
    if (( user_flag_count == 0 )) && (( ${#file_flags[@]} == 0 )); then
        defaults=($DEFAULT_FLAGS --port 11434 --host 127.0.0.1)
    fi
    all_flags=("${defaults[@]}" "${file_flags[@]}" "${EXTRA_FLAGS[@]}")

    if [[ -z "$model_name" ]]; then
        echo "Error: No model path (-m) found in config or argument." >&2
        exit 1
    fi

    local llama_server_bin
    llama_server_bin=$(resolve_llama_cmd "llama-server")
    if [[ $? -ne 0 ]]; then exit 1; fi

    # Resolve effective port/host for the message (user-specified values)
    local port="11434" host="127.0.0.1"
    local p_val
    if p_val=$(find_flag_value "--port" "${EXTRA_FLAGS[@]}"); then port="$p_val"
    elif p_val=$(find_flag_value "--port" "${file_flags[@]}"); then port="$p_val"
    elif p_val=$(find_flag_value "--port" "${defaults[@]}"); then port="$p_val"
    fi
    if p_val=$(find_flag_value "--host" "${EXTRA_FLAGS[@]}"); then host="$p_val"
    elif p_val=$(find_flag_value "--host" "${file_flags[@]}"); then host="$p_val"
    elif p_val=$(find_flag_value "--host" "${defaults[@]}"); then host="$p_val"
    fi
    echo "🚀 Starting '$model_name' in SERVER MODE (Daemonized)..."
    nohup "$llama_server_bin" -m "$model_name" "${all_flags[@]}" > /dev/null 2>&1 &
    echo "✅ Process started. Access at http://$host:$port"
}

cmd_stop() {
    echo "🛑 Stopping all dalpaca instances..."
    pkill -f "llama"
    echo "✅ All instances stopped."
}

cmd_ps() {
    echo "📋 Currently Running Models:"
    echo "-------------------------------------------"
    ps aux | grep "[l]lama" | while read -r line; do
        pid=$(echo "$line" | awk '{print $2}')
        cmd=$(echo "$line" | awk '{for(i=11;i<=NF;i++) printf "%s ", $i; print ""}')
        echo "PID: $pid | $cmd"
    done | sort
    if ! ps aux | grep "[l]lama" > /dev/null; then
        echo " (No active instances)"
    fi
    echo "-------------------------------------------"
}

