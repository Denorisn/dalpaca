#!/usr/bin/env bash

# dalpaca: Local LLM Manager
# A lightweight llama.cpp runtime manager for linux.

set -e

# --- Configuration ---
SEARCH_PATHS=("$HOME/Models")
CLI_CMD="llama-cli"
SERVER_CMD="llama-server"

# Defaults (The Sweet Spot)
DEFAULT_FLAGS="--mlock --ngl 52 --ctx-size 32768 --threads 16 --numa --flash-attn --temp 0.7"

# --- Helpers ---

# Resolve model path from filename, relative path, or absolute path
resolve_model() {
    local model_name="$1"
    
    # 1. Check current working directory (Terminal path)
    if [[ -f "./$model_name" ]]; then
        echo "./$model_name"
        return 0
    fi

    # 2. Check absolute path
    if [[ -f "$model_name" ]]; then
        echo "$model_name"
        return 0
    fi

    # 3. Fallback to hardcoded search paths
    for dir in "${SEARCH_PATHS[@]}"; do
        if [[ -f "$dir/$model_name" ]]; then
            echo "$dir/$model_name"
            return 0
        fi
    done

    echo "Error: Model '$model_name' not found." >&2
    return 1
}

# --- Commands ---

cmd_run() {
    local config_file=""
    local model_name=""
    local file_flags=()
    local extra_flags=()

    # 1. Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -*)
                extra_flags+=("$1")
                shift
                ;;
            *)
                config_file="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$config_file" ]]; then
        echo "Usage: dalpaca run <model_filename.txt | model_name>" >&2
        exit 1
    fi

    if [[ -f "$config_file" ]]; then
        echo "📄 Using configuration from: $config_file"
        model_name=$(grep -E '^-m ' "$config_file" | awk '{print $2}')
        while IFS= read -r flag; do
            [[ -z "$flag" || "$flag" =~ ^# ]] && continue
            file_flags+=("$flag")
        done < <(grep -v '^-m ' "$config_file")

    else
        model_name=$(resolve_model "$config_file")
        if [[ $? -ne 0 ]]; then exit 1; fi
    fi

    local all_flags=($DEFAULT_FLAGS "${file_flags[@]}" "${extra_flags[@]}")

    if [[ -z "$model_name" ]]; then
        echo "Error: No model path (-m) found in config or argument." >&2
        exit 1
    fi

    echo "🚀 Starting '$model_name' in CLI MODE (Foreground)..."
    $CLI_CMD -m "$model_name" "${all_flags[@]}"
}

cmd_server() {
    local config_file=""
    local model_name=""
    local file_flags=()
    local extra_flags=()

    # 1. Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -*)
                extra_flags+=("$1")
                shift
                ;;
            *)
                config_file="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$config_file" ]]; then
        echo "Usage: dalpaca server <model_filename.txt | model_name>" >&2
        exit 1
    fi

    if [[ -f "$config_file" ]]; then
        echo "📄 Using configuration from: $config_file"
        model_name=$(grep -E '^-m ' "$config_file" | awk '{print $2}')
        while IFS= read -r flag; do
            [[ -z "$flag" || "$flag" =~ ^# ]] && continue
            file_flags+=("$flag")
        done < <(grep -v '^-m ' "$config_file")

    else
        model_name=$(resolve_model "$config_file")
        if [[ $? -ne 0 ]]; then exit 1; fi
    fi

    # Add default server flags
    local server_defaults=($DEFAULT_FLAGS --port 11434 --host 127.0.0.1)
    local all_flags=("${server_defaults[@]}" "${file_flags[@]}" "${extra_flags[@]}")

    if [[ -z "$model_name" ]]; then
        echo "Error: No model path (-m) found in config or argument." >&2
        exit 1
    fi

    echo "🚀 Starting '$model_name' in SERVER MODE (Daemonized)..."
    nohup $SERVER_CMD -m "$model_name" "${all_flags[@]}" > /dev/null 2>&1 &
    echo "✅ Process started. Access at http://localhost:11434"
}

cmd_stop() {
    echo "🛑 Stopping all dalpaca instances..."
    pkill -f "llama"
    echo "✅ All instances stopped."
}

cmd_list() {
    echo "📋 Currently Running Models:"
    echo "-------------------------------------------"
    ps aux | grep "[l]lama" | while read -r line; do
        pid=$(echo "$line" | awk '{print $2}')
        cmd=$(echo "$line" | awk '{for(i=11;i<=NF;i++) printf "%s ", $i; print ""}')
        echo "PID: $pid | $cmd"
    done | sort
    if ! ps aux | grep "[l]lama" > /dev/null; then
        echo " (No active instances)"
    fi
    echo "-------------------------------------------"
}

cmd_help() {
    echo "dalpaca: Local LLM Manager"
    echo ""
    echo "Usage:"
    echo "  dalpaca run <model_name>              Run in CLI mode (Interactive)"
    echo "  dalpaca run ./config.txt              Run using a config file"
    echo "  dalpaca server <model_name>           Run in Server mode (Daemonized/Web UI)"
    echo "  dalpaca server <config.txt>           Run server using a config file"
    echo "  dalpaca stop                          Stop all models"
    echo "  dalpaca list                          Show running models"
    echo ""
    echo "Config file (.txt) format:"
    echo "  -m /path/to/model.gguf"
    echo "  --ngl 40"
    echo "  --ctx-size 65536"
    echo "  --system \"Your system prompt here\""
}

# --- Main Dispatcher ---

if [[ $# -eq 0 ]]; then
    cmd_help
    exit 0
fi

case "$1" in
    run)    shift; cmd_run "$@" ;;
    server) shift; cmd_server "$@" ;;
    stop)   cmd_stop ;;
    list|ls) cmd_list ;;
    help)   cmd_help ;;
    *)      echo "Unknown command: $1"; cmd_help; exit 1 ;;
esac
