# --- Interactive Wizard (no-arg TUI) ---

cmd_wizard() {
    # Needs a real TTY; otherwise fall back to help
    if [[ ! -t 0 || ! -t 1 ]]; then
        cmd_help
        return 0
    fi

    local prev_stty
    prev_stty=$(stty -g 2>/dev/null) || { cmd_help; return 0; }
    stty -echo 2>/dev/null || true

    _wiz_cleanup() { stty "$prev_stty" 2>/dev/null || true; }
    trap '_wiz_cleanup' EXIT INT TERM

    # Build choice list
    local names=()
    local f base
    for f in "$DALPACA_HOME"/*.txt; do
        [[ -f "$f" ]] || continue
        base=$(basename "$f" .txt)
        [[ "$base" == "llama_dir" ]] && continue
        names+=("$base")
    done
    names+=("__new__")
    local max_idx=$(( ${#names[@]} - 1 ))
    local sel=0
    local mode="list"       # list | action | import | name
    local act_sel=0
    local import_path=""
    local new_name=""

    # Read one keypress
    _wiz_key() {
        local key
        IFS= read -r -s -n1 key 2>/dev/null || return 1
        if [[ "$key" == $'\x1b' ]]; then
            local rest=""
            IFS= read -r -s -n2 -t 0.05 rest 2>/dev/null || rest=""
            case "$rest" in
                *"[A"|*OA) printf 'up' ;;
                *"[B"|*OB) printf 'down' ;;
                *) printf '' ;;
            esac
        else
            printf '%s' "$key"
        fi
    }

    # Draw screen
    _wiz_draw() {
        clear
        printf '\n'
        printf '  dalpaca  v%s\n' "$DALPACA_VERSION"
        if [[ -n "$LLAMA_DIR" ]]; then
            printf '  llama.cpp: %s\n' "$LLAMA_DIR"
        else
            printf '  llama.cpp: (not set — using PATH)\n'
        fi
        printf '  ─────────────────────────────────────────────────\n'

        if [[ "$mode" == "list" ]]; then
            printf '  ── Registered Models ──────────────────────\n'
            local i
            for i in "${!names[@]}"; do
                local label
                if [[ "${names[$i]}" == "__new__" ]]; then
                    label="➕  New from file…"
                else
                    label="${names[$i]}"
                fi
                if (( i == sel )); then
                    printf '  ▶ %s\n' "$label"
                else
                    printf '    %s\n' "$label"
                fi
            done
            printf '  ─────────────────────────────────────────────────\n'
            printf '  ↑/↓ navigate · Enter select · q quit\n'

        elif [[ "$mode" == "action" ]]; then
            printf '  ── %s ────────────────────────────────────\n' "${names[$sel]}"
            local opts=("  ▶ CLI — interactive foreground"
                       "  ▶ Server — background daemon"
                       "  ◀  Back")
            local i
            for i in "${!opts[@]}"; do
                if (( i == act_sel )); then
                    printf '  %s\n' "${opts[$i]}"
                else
                    printf '    %s\n' "${opts[$i]}"
                fi
            done
            printf '  ─────────────────────────────────────────────────\n'
            printf '  ↑/↓ navigate · Enter select · q quit\n'

        elif [[ "$mode" == "import" ]]; then
            printf '  New from file\n'
            printf '  ─────────────────────────────────────────────────\n'
            if [[ -n "$import_path" ]]; then
                printf '  Config file: %s\n' "$import_path"
            else
                printf '  Config file: (enter path)\n'
            fi
            printf '  ─────────────────────────────────────────────────\n'
            printf '  Enter to continue · q cancel\n'

        elif [[ "$mode" == "name" ]]; then
            printf '  Register: %s\n' "$import_path"
            printf '  ─────────────────────────────────────────────────\n'
            if [[ -n "$new_name" ]]; then
                printf '  Name: %s\n' "$new_name"
            else
                printf '  Name: (enter name)\n'
            fi
            printf '  ─────────────────────────────────────────────────\n'
            printf '  Enter to register · q cancel\n'
        fi
    }

    # Main loop
    local key
    while :; do
        _wiz_draw

        key=$(_wiz_key) || key="EOF"

        case "$key" in
            "up")
                case "$mode" in
                    "list")  (( sel > 0 )) && sel=$(( sel - 1 )) || true ;;
                    "action") act_sel=$(( (act_sel + 2) % 3 )) || true ;;
                esac
                ;;
            "down")
                case "$mode" in
                    "list")  (( sel < max_idx )) && sel=$(( sel + 1 )) || true ;;
                    "action") act_sel=$(( (act_sel + 1) % 3 )) || true ;;
                esac
                ;;
            $'\n' | $'\r' | ' ')
                case "$mode" in
                    "list")
                        if [[ "${names[$sel]}" == "__new__" ]]; then
                            mode="import"
                            import_path=""
                        else
                            mode="action"
                            act_sel=0
                        fi
                        ;;
                    "action")
                        case $act_sel in
                            0) _wiz_cleanup; cmd_run "${names[$sel]}"; return 0 ;;
                            1) _wiz_cleanup; cmd_server "${names[$sel]}"; return 0 ;;
                            2) mode="list" ;;
                        esac
                        ;;
                    "import")
                        if [[ -n "$import_path" && -f "$import_path" ]]; then
                            mode="name"
                            new_name=""
                        fi
                        ;;
                    "name")
                        if [[ -n "$new_name" ]]; then
                            cp "$import_path" "$DALPACA_HOME/${new_name}.txt"
                            names=()
                            for f in "$DALPACA_HOME"/*.txt; do
                                [[ -f "$f" ]] || continue
                                base=$(basename "$f" .txt)
                                [[ "$base" == "llama_dir" ]] && continue
                                names+=("$base")
                            done
                            names+=("__new__")
                            max_idx=$(( ${#names[@]} - 1 ))
                            local idx=0
                            for n in "${names[@]}"; do
                                if [[ "$n" == "$new_name" ]]; then
                                    sel=$idx
                                    break
                                fi
                                idx=$(( idx + 1 ))
                            done
                            mode="action"
                            act_sel=0
                        fi
                        ;;
                esac
                ;;
            q | Q) _wiz_cleanup; return 0 ;;
            $'\x1b')
                case "$mode" in
                    "action"|"import"|"name") mode="list" ;;
                    *) _wiz_cleanup; return 0 ;;
                esac
                ;;
            $'\x7f')
                case "$mode" in
                    "import") import_path="${import_path%?}" ;;
                    "name") new_name="${new_name%?}" ;;
                esac
                ;;
            "EOF") _wiz_cleanup; return 0 ;;
        esac
    done
}

load_llama_config

# --- Main Dispatcher ---

if [[ $# -eq 0 ]]; then
    cmd_wizard
    exit 0
fi

case "$1" in
    run)        shift; cmd_run "$@" ;;
    server)     shift; cmd_server "$@" ;;
    stop)       cmd_stop ;;
    ps)         cmd_ps ;;
    set-llama)  shift; cmd_set_llama "$@" ;;
    recommend)  shift; cmd_recommend "$@" ;;
    help|--help|-h) cmd_help ;;
esac
