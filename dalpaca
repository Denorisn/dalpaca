    local config_file=""
    local model_name=""
    local file_flags=()
    local all_flags=()

    # 1. Parse arguments with proper flag-value pairing
    parse_args "$@"
    local user_flag_count=${#EXTRA_FLAGS[@]}
    config_file="${MODEL_ARG:-}"

    if [[ -z "$config_file" ]]; then
